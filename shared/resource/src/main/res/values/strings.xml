    <string name="privacy_intro_title">Overview</string>
    <string name="privacy_intro_body">Moneyfikasi is a personal finance app for tracking wallets, income, expenses, transfers, categories, budgets, presets, recurring transactions, statistics, and reports. The app is designed to keep your financial records on your device unless you choose to export or back them up.</string>
    <string name="privacy_data_stored_title">Data You Enter</string>
    <string name="privacy_data_stored_body">The app stores the financial information you create, including wallet names and balances, categories, transaction amounts, notes, dates, budgets, presets, recurring transaction schedules, notification preferences, appearance settings, language settings, and app lock settings.</string>
    <string name="privacy_local_storage_title">Local Storage</string>
    <string name="privacy_local_storage_body">Your app data is stored locally on your device. Moneyfikasi does not require an account, does not upload your financial records to a Moneyfikasi server, and does not sell your data.</string>
    <string name="privacy_backups_exports_title">Backups and Exports</string>
    <string name="privacy_backups_exports_body">If you use backup, restore, or export features, the app creates files such as backups, CSV files, XLSX files, or saved images in the location you select or authorize. Anyone with access to those files may be able to read the data inside them, so keep exported and backup files in a secure place.</string>
    <string name="privacy_notifications_title">Notifications</string>
    <string name="privacy_notifications_body">If you enable notifications, Moneyfikasi may create local notifications for recurring transactions and related reminders. Notification permission is controlled by your device settings and can be changed at any time.</string>
    <string name="privacy_security_title">Security</string>
    <string name="privacy_security_body">App lock, PIN, and biometric options help protect access to the app on your device. Biometric verification is handled by Android system services. These features do not replace device-level security, encrypted backups, or careful handling of exported files.</string>
    <string name="privacy_third_party_title">Third-Party Services</string>
    <string name="privacy_third_party_body">Moneyfikasi may rely on Android system components and open source libraries to run app features. The app does not intentionally share your financial records with third-party services.</string>
    <string name="privacy_user_control_title">Your Control</string>
    <string name="privacy_user_control_body">You can add, edit, delete, export, back up, restore, or remove your data using the app features and Android storage controls. Uninstalling the app or clearing app data from Android settings may remove local records stored by the app.</string>
    <string name="privacy_changes_title">Policy Changes</string>
    <string name="privacy_changes_body">This privacy policy may be updated when Moneyfikasi features change. Review this screen after updates to understand how app data is handled.</string>
    <string name="terms_acceptance_title">Acceptance</string>
    <string name="terms_acceptance_body">By using Moneyfikasi, you agree to these terms. If you do not agree, stop using the app and remove it from your device.</string>
    <string name="terms_use_title">Use of the App</string>
    <string name="terms_use_body">Moneyfikasi is provided for personal finance tracking. You are responsible for the transactions, wallets, categories, budgets, presets, recurring schedules, notes, backups, and exports you create in the app.</string>
    <string name="terms_financial_title">No Financial Advice</string>
    <string name="terms_financial_body">Moneyfikasi helps organize and summarize information you enter. It does not provide financial, investment, tax, legal, or accounting advice. Any decisions based on your records, reports, budgets, or statistics are your responsibility.</string>
    <string name="terms_user_data_title">Accuracy of Data</string>
    <string name="terms_user_data_body">Reports, balances, trends, and statistics depend on the data you enter. Check important records before relying on them, especially before making purchases, transfers, budgets, or financial decisions.</string>
    <string name="terms_backups_exports_title">Backups, Restore, and Export</string>
    <string name="terms_backups_exports_body">Backup, restore, and export features are provided to help you manage your data. You are responsible for choosing secure storage locations, protecting exported files, and checking backups before restoring because restore actions can overwrite current app data.</string>
    <string name="terms_security_title">Security</string>
    <string name="terms_security_body">PIN and biometric options can help restrict access to Moneyfikasi on your device, but you remain responsible for device security, Android account access, backup file protection, and any data shared from your device.</string>
    <string name="terms_availability_title">Availability and Limitations</string>
    <string name="terms_availability_body">The app is provided as available. Features may change, contain errors, or depend on Android system behavior, device storage, notification permission, file access, or installed apps that can open exported files.</string>
    <string name="terms_changes_title">Changes to Terms</string>
    <string name="terms_changes_body">These terms may be updated when Moneyfikasi changes. Continued use of the app after updates means you accept the latest terms shown on this screen.</string>
